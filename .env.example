# Токен бота от @BotFather
BOT_TOKEN=

# Ключ шифрования токенов продавцов. Сгенерировать один раз и больше не менять:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=

# Как часто опрашивать Playerok, секунд
POLL_INTERVAL=30

# Telegram ID админов через запятую: им доступны платные плагины и команды /grant, /revoke
ADMIN_IDS=
# Куда писать за доступом к платным плагинам (показывается пользователям), например @username
OWNER_CONTACT=

# База данных. По умолчанию SQLite в папке data/
# DB_URL=sqlite+aiosqlite:///./data/bot.db

# Прокси для запросов к Playerok, если сайт блокирует IP хостинга (HTTP 403):
# PLAYEROK_PROXY=http://user:pass@host:port

# Звёзды через Fragment (необязательно):
# TONCENTER_API_KEY=   ключ toncenter.com, без него жёсткие лимиты запросов
# FRAGMENT_PROXY=      прокси для fragment.com, если хостинг не пускают
# FRAGMENT_USDT_CURRENCY=usdt_ton   как Fragment называет оплату USDT в сети TON
